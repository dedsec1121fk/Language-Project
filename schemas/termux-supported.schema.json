{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Language Project Termux Supported Language Registry",
  "type": "object",
  "required": ["schema", "project", "count", "languages"],
  "properties": {
    "schema": {"type": "integer"},
    "project": {"type": "string"},
    "source": {"type": "string"},
    "count": {"type": "integer", "minimum": 1},
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "packages", "command", "extension", "linguist", "tier", "official_package_verified", "github_linguist_supported"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "packages": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "command": {"type": "string"},
          "extension": {"type": "string"},
          "linguist": {"type": "string"},
          "tier": {"enum": ["worker", "native-module"]},
          "official_package_verified": {"type": "boolean"},
          "github_linguist_supported": {"type": "boolean"}
        }
      }
    }
  }
}
