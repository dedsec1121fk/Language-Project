{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Language Project executable language module metadata",
  "type": "object",
  "required": ["schema", "project", "id", "name", "kind", "termux_packages", "native_tool", "execution_policy", "runtime_home", "uses"],
  "properties": {
    "schema": {"const": 1},
    "project": {"const": "Language Project"},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "kind": {"enum": ["compiled", "interpreted", "vm"]},
    "termux_packages": {"type": "array", "items": {"type": "string"}},
    "worker_protocol": {"type": "string"},
    "native_tool": {
      "type": "object",
      "required": ["id", "name", "category", "source"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "category": {"type": "string"},
        "source": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "execution_policy": {"type": "string"},
    "runtime_home": {"const": "$HOME/Language Project"},
    "uses": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
