{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Language Project Native Multi-Language Tool Registry",
  "type": "object",
  "required": ["schema", "project", "count", "tools"],
  "properties": {
    "schema": {"const": 1},
    "project": {"const": "Language Project"},
    "count": {"type": "integer", "minimum": 1},
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "language_id", "language", "name", "category", "source", "run", "smoke_args", "tags"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "language_id": {"type": "string", "minLength": 1},
          "language": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "run": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "build": {"type": ["array", "null"], "items": {"type": "string"}},
          "smoke_args": {"type": "array", "items": {"type": "string"}},
          "tags": {"type": "array", "items": {"type": "string"}},
          "arg_mode": {"enum": ["stdin", "env"]}
        }
      }
    }
  }
}
