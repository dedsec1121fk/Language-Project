{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://language-project.local/schemas/polyglot.schema.json",
  "title": "Language Project Practical Polyglot Artifact",
  "type": "object",
  "required": [
    "format",
    "schema",
    "type",
    "project",
    "language_order"
  ],
  "properties": {
    "format": {
      "const": "language-project-polyglot"
    },
    "schema": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "enum": [
        "seal",
        "lpack",
        "directory-audit",
        "protected-backup-receipt",
        "split-parts"
      ]
    },
    "project": {
      "const": "Language Project"
    },
    "language_order": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
