{
  "schema": 1,
  "project": "Language Project",
  "id": "zsh",
  "name": "Z shell",
  "kind": "interpreted",
  "termux_packages": [
    "zsh",
    "coreutils"
  ],
  "worker_protocol": "PING / E <hex> / D <hex> / QUIT",
  "native_tool": {
    "id": "recent-files",
    "name": "Recent Files",
