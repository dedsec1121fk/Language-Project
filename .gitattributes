# Language Project GitHub Linguist rules
# Generated from config/registries/termux_supported.json.
# Every override below maps real source to its actual language; Python is not relabeled.

# Catalog and generated metadata are not source-code statistics.
catalog/** linguist-vendored=true
metadata/** linguist-vendored=true

# Termux-supported languages recognized by current GitHub Linguist.
